#!/bin/bash

################################################################################
# Documentation Organization Skill
# Purpose: Organize markdown files into docs/ folder
# Moves all .md files except spec.md and README.md to docs/
################################################################################

set -e

# Configuration
EXCLUDE_FILES=("spec.md" "README.md" "readme.md")
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCS_DIR="$PROJECT_DIR/docs"

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Logging
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[✓]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $1"; }
log_error() { echo -e "${RED}[✗]${NC} $1"; }

################################################################################
# Check if file should be excluded
################################################################################

should_exclude() {
    local file="$1"
    local filename=$(basename "$file")

    for exclude in "${EXCLUDE_FILES[@]}"; do
        if [[ "$filename" == "$exclude" ]]; then
            return 0  # Should exclude
        fi
    done
    return 1  # Should not exclude
}

################################################################################
# Create docs directory
################################################################################

create_docs_dir() {
    log_info "Creating docs directory..."

    if [[ -d "$DOCS_DIR" ]]; then
        log_warn "docs/ directory already exists"
        return
    fi

    mkdir -p "$DOCS_DIR"
    log_success "Created: $DOCS_DIR"
}

################################################################################
# Move markdown files to docs/
################################################################################

move_markdown_files() {
    log_info "Finding markdown files to move..."

    local moved_count=0
    local skipped_count=0

    # Find all .md files in root aff-atg directory (not subdirs)
    while IFS= read -r file; do
        # Skip if in subdirectories
        if [[ "$file" == *"/"* ]]; then
            continue
        fi

        # Skip if should be excluded
        if should_exclude "$file"; then
            log_warn "Skipping: $(basename "$file")"
            ((skipped_count++))
            continue
        fi

        # Move file
        local filename=$(basename "$file")
        log_info "Moving: $filename → docs/"
        mv "$file" "$DOCS_DIR/$filename"
        ((moved_count++))
    done < <(find "$PROJECT_DIR" -maxdepth 1 -name "*.md" -type f 2>/dev/null | sort)

    log_success "Moved $moved_count files to docs/"
    log_info "Skipped $skipped_count files (spec.md, README.md)"
}

################################################################################
# Update relative links in moved files
################################################################################

update_relative_links() {
    log_info "Updating relative links in moved files..."

    local updated=0

    # Find all .md files in docs/ and update links
    while IFS= read -r file; do
        # Check if file contains relative links to files in parent directory
        if grep -q "\[.*\](.*\.md)" "$file" 2>/dev/null; then
            # Count how many links might need updating
            local link_count=$(grep -o "\[.*\](.*\.md)" "$file" 2>/dev/null | wc -l)
            if [[ $link_count -gt 0 ]]; then
                log_warn "Review links in: $(basename "$file") ($link_count links found)"
                ((updated++))
            fi
        fi
    done < <(find "$DOCS_DIR" -maxdepth 1 -name "*.md" -type f 2>/dev/null)

    if [[ $updated -gt 0 ]]; then
        log_warn "Note: $updated files may need link updates (review manually)"
        log_info "Links to files in parent directory may need '../' prefix"
    fi
}

################################################################################
# Show directory structure
################################################################################

show_structure() {
    log_info "Documentation structure:"
    echo ""
    echo "aff-atg/"
    echo "  ├── spec.md (kept in root)"
    echo "  ├── README.md (kept in root)"
    echo "  ├── docs/"

    # Count files
    local file_count=$(find "$DOCS_DIR" -maxdepth 1 -name "*.md" -type f 2>/dev/null | wc -l)

    if [[ $file_count -gt 0 ]]; then
        find "$DOCS_DIR" -maxdepth 1 -name "*.md" -type f 2>/dev/null | sort | while read file; do
            local filename=$(basename "$file")
            local size=$(du -h "$file" 2>/dev/null | cut -f1)
            local lines=$(wc -l < "$file" 2>/dev/null || echo "?")
            echo "  │   ├── $filename ($size, $lines lines)"
        done
    else
        echo "  │   └── (empty)"
    fi

    echo "  └── ... (other files)"
    echo ""
}

################################################################################
# Generate index of moved files
################################################################################

generate_docs_index() {
    log_info "Generating documentation index..."

    local index_file="$DOCS_DIR/INDEX.md"

    cat > "$index_file" << 'EOF'
# Documentation Index

All project documentation organized alphabetically.

EOF

    # List all docs
    find "$DOCS_DIR" -maxdepth 1 -name "*.md" -type f 2>/dev/null | sort | while read file; do
        local filename=$(basename "$file")

        # Skip the index itself
        if [[ "$filename" == "INDEX.md" ]]; then
            continue
        fi

        # Extract title
        local title=$(grep -m1 "^# " "$file" 2>/dev/null | sed 's/^# //' || echo "$filename")

        # Extract first paragraph as summary
        local summary=$(grep -v "^#" "$file" 2>/dev/null | grep -v "^$" | head -1 | cut -c 1-80)

        echo "## $title" >> "$index_file"
        echo "" >> "$index_file"
        echo "**File**: \`$filename\`" >> "$index_file"
        echo "" >> "$index_file"
        if [[ ! -z "$summary" ]]; then
            echo "**Summary**: $summary" >> "$index_file"
        fi
        echo "" >> "$index_file"
    done

    log_success "Created: $index_file"
}

################################################################################
# Organize (main function)
################################################################################

organize() {
    log_info "================================"
    log_info "ORGANIZING DOCUMENTATION"
    log_info "================================"
    echo ""

    create_docs_dir
    move_markdown_files
    update_relative_links
    generate_docs_index
    show_structure

    log_success "Documentation organization complete!"
    echo ""
    log_info "Next steps:"
    log_info "  1. Review files in docs/ directory"
    log_info "  2. Check relative links in moved files"
    log_info "  3. Run: git add docs/"
    log_info "  4. Commit changes"
    echo ""
}

################################################################################
# Cleanup (reverse operation)
################################################################################

cleanup() {
    log_warn "REVERTING ORGANIZATION"

    if [[ ! -d "$DOCS_DIR" ]]; then
        log_error "docs/ directory not found"
        return 1
    fi

    read -p "Move all files from docs/ back to root? (yes/no): " confirm
    if [[ "$confirm" != "yes" ]]; then
        log_info "Cleanup cancelled"
        return
    fi

    local moved_count=0
    while IFS= read -r file; do
        local filename=$(basename "$file")
        if [[ "$filename" != "INDEX.md" ]]; then
            log_info "Moving: $filename → root"
            mv "$file" "$PROJECT_DIR/$filename"
            ((moved_count++))
        fi
    done < <(find "$DOCS_DIR" -maxdepth 1 -name "*.md" -type f 2>/dev/null | sort)

    log_success "Moved $moved_count files back to root"

    # Keep or remove INDEX.md
    read -p "Remove docs/INDEX.md? (yes/no): " remove_index
    if [[ "$remove_index" == "yes" ]]; then
        rm -f "$DOCS_DIR/INDEX.md"
    fi

    # Remove empty docs directory
    if [[ -z "$(ls -A "$DOCS_DIR" 2>/dev/null)" ]]; then
        rmdir "$DOCS_DIR"
        log_success "Removed empty docs/ directory"
    else
        log_warn "docs/ directory not empty, keeping it"
    fi
}

################################################################################
# Show status
################################################################################

show_status() {
    log_info "Documentation Organization Status"
    echo ""

    if [[ ! -d "$DOCS_DIR" ]]; then
        log_error "docs/ directory does not exist"
        log_info "Run: skill-organize-docs --organize"
        return 1
    fi

    local file_count=$(find "$DOCS_DIR" -maxdepth 1 -name "*.md" -type f 2>/dev/null | wc -l)
    local total_size=$(du -sh "$DOCS_DIR" 2>/dev/null | cut -f1)

    echo "Status: ✓ Organized"
    echo "Location: $DOCS_DIR"
    echo "Files: $file_count"
    echo "Size: $total_size"
    echo ""

    echo "Files in docs/:"
    find "$DOCS_DIR" -maxdepth 1 -name "*.md" -type f 2>/dev/null | sort | while read file; do
        echo "  - $(basename "$file")"
    done
    echo ""

    echo "Files in root (protected):"
    echo "  - spec.md"
    echo "  - README.md"
}

################################################################################
# Main
################################################################################

main() {
    local action="${1:-help}"

    case "$action" in
        --organize|organize)
            organize
            ;;

        --cleanup|cleanup|--revert|revert)
            cleanup
            ;;

        --status|status)
            show_status
            ;;

        --help|help|-h)
            cat << 'HELP'
Documentation Organization Skill - Organize markdown files into docs/ folder

Usage: skill-organize-docs [COMMAND]

Commands:
  --organize     Organize markdown files into docs/ folder
  --cleanup      Revert organization (move files back to root)
  --status       Show organization status
  --help         Show this help message

Features:
  - Creates docs/ directory under aff-atg
  - Moves all .md files to docs/ (except spec.md, README.md)
  - Generates INDEX.md with file catalog
  - Preserves root-level files (spec.md, README.md)
  - Warns about relative links that may need updating
  - Provides cleanup to revert changes

Examples:
  skill-organize-docs --organize           # Organize documentation
  skill-organize-docs --status             # Check current status
  skill-organize-docs --cleanup            # Revert to original structure

Protected Files (stay in root):
  - spec.md
  - README.md

All Other .md Files:
  - Moved to docs/
  - Listed in docs/INDEX.md
  - May need link updates (relative paths)

Notes:
  - Links to parent directory files need '../' prefix after moving
  - Review docs/INDEX.md for file catalog
  - Use --cleanup to revert at any time
HELP
            ;;

        *)
            log_error "Unknown command: $action"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
}

main "$@"
