#!/bin/bash

# Skill: Validate Peer IPs
# Purpose: Prevent IP collisions before adding new VPN peers
# Usage: ./skill-validate-peer-ips [--peer NAME] [--tunnel1 CIDR] [--tunnel2 CIDR] [--asn ASN] [--peer-cidrs CIDR1,CIDR2]

set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

# Configuration
REGISTRY_FILE="vpn-peers-registry.yaml"
AUDIT_LOG="vpn-peers-audit.log"

print_status() {
    local status=$1
    local message=$2

    case $status in
        "pass")
            echo -e "${GREEN}✓${NC} $message"
            ;;
        "warn")
            echo -e "${YELLOW}⚠${NC} $message"
            ;;
        "fail")
            echo -e "${RED}✗${NC} $message"
            ;;
        "info")
            echo -e "${BLUE}ℹ${NC} $message"
            ;;
    esac
}

print_header() {
    echo -e "\n${BOLD}${BLUE}=== $1 ===${NC}\n"
}

# Check if registry exists
check_registry() {
    if [ ! -f "$REGISTRY_FILE" ]; then
        print_status "fail" "Registry not found: $REGISTRY_FILE"
        exit 1
    fi
    print_status "pass" "Registry loaded: $REGISTRY_FILE"
}

# Parse YAML (simple version for our use case)
get_allocated_cidrs() {
    grep -E "^\s+- \"169\.254\." "$REGISTRY_FILE" | sed 's/.*"\(169\.254\.[^"]*\)".*/\1/' | sort
}

get_allocated_asns() {
    grep -E "^\s+- [0-9]{5}" "$REGISTRY_FILE" | sed 's/.*- \([0-9]*\).*/\1/' | sort
}

get_allocated_peer_cidrs() {
    grep -E "^\s+- \"172\." "$REGISTRY_FILE" | sed 's/.*"\(172\.[^"]*\)".*/\1/' | sort
}

# Check for CIDR conflicts
check_cidr_collision() {
    local cidr=$1
    local allocated=$(get_allocated_cidrs)

    if echo "$allocated" | grep -q "^${cidr}$"; then
        print_status "fail" "COLLISION: Inside CIDR $cidr already allocated"
        return 1
    fi

    print_status "pass" "Inside CIDR $cidr: Available"
    return 0
}

# Check for ASN conflicts
check_asn_collision() {
    local asn=$1
    local allocated=$(get_allocated_asns)

    if [ "$asn" = "64512" ]; then
        print_status "fail" "COLLISION: ASN $asn is AWS reserved"
        return 1
    fi

    if echo "$allocated" | grep -q "^${asn}$"; then
        print_status "fail" "COLLISION: BGP ASN $asn already allocated"
        return 1
    fi

    print_status "pass" "BGP ASN $asn: Available"
    return 0
}

# Check for peer CIDR overlap
check_peer_cidr_overlap() {
    local cidr=$1
    local allocated=$(get_allocated_peer_cidrs)

    if echo "$allocated" | grep -q "^${cidr}$"; then
        print_status "fail" "COLLISION: Peer CIDR $cidr already allocated"
        return 1
    fi

    print_status "pass" "Peer CIDR $cidr: Available"
    return 0
}

# Parse CIDR to get network address
cidr_network() {
    local cidr=$1
    echo "$cidr" | cut -d'/' -f1
}

# Get next available inside CIDR
get_next_available_cidr() {
    local allocated=$(get_allocated_cidrs)
    local current=10

    while [ $current -lt 254 ]; do
        local candidate="169.254.${current}.0/30"
        if ! echo "$allocated" | grep -q "^169\.254\.${current}\.0/30$"; then
            echo "$candidate"
            return 0
        fi
        current=$((current + 1))
    done

    print_status "fail" "No available inside CIDRs!"
    return 1
}

# Get next available ASN
get_next_available_asn() {
    local allocated=$(get_allocated_asns)
    local current=65000

    while [ $current -le 65534 ]; do
        if ! echo "$allocated" | grep -q "^${current}$"; then
            echo "$current"
            return 0
        fi
        current=$((current + 1))
    done

    print_status "fail" "No available ASNs!"
    return 1
}

# Get next available peer CIDR (suggest based on pattern)
get_next_available_peer_cidr() {
    local allocated=$(get_allocated_peer_cidrs)
    local current=19

    while [ $current -le 253 ]; do
        local candidate="172.${current}.0.0/16"
        if ! echo "$allocated" | grep -q "^172\.${current}\.0\.0/16$"; then
            echo "$candidate"
            return 0
        fi
        current=$((current + 1))
    done

    print_status "fail" "No available peer CIDRs in 172.x.0.0/16 range!"
    return 1
}

# Validate single peer
validate_peer() {
    local peer_name=$1
    local tunnel1_cidr=$2
    local tunnel2_cidr=$3
    local bgp_asn=$4
    local peer_cidr=$5

    print_header "Validating Peer: $peer_name"

    local failed=0

    # Validate tunnel 1 CIDR
    if ! check_cidr_collision "$tunnel1_cidr"; then
        failed=$((failed + 1))
    fi

    # Validate tunnel 2 CIDR
    if ! check_cidr_collision "$tunnel2_cidr"; then
        failed=$((failed + 1))
    fi

    # Validate BGP ASN
    if ! check_asn_collision "$bgp_asn"; then
        failed=$((failed + 1))
    fi

    # Validate peer CIDR
    if ! check_peer_cidr_overlap "$peer_cidr"; then
        failed=$((failed + 1))
    fi

    echo ""

    if [ $failed -eq 0 ]; then
        print_status "pass" "All validations passed for $peer_name"
        return 0
    else
        print_status "fail" "$failed validation(s) failed for $peer_name"
        return 1
    fi
}

# Suggest next peer allocations
suggest_allocations() {
    print_header "Suggested Allocations for Next Peer"

    local next_cidr1=$(get_next_available_cidr)
    local next_asn=$(get_next_available_asn)
    local next_peer_cidr=$(get_next_available_peer_cidr)

    echo "When adding the next peer, use:"
    echo ""
    echo "  Tunnel 1 Inside CIDR: $next_cidr1"
    echo "  Tunnel 2 Inside CIDR: ${next_cidr1/%.0/.1}  (auto-generated)"
    echo "  BGP ASN:             $next_asn"
    echo "  Peer CIDR:           $next_peer_cidr"
    echo ""
    print_status "info" "Add these to vpn-peers-registry.yaml before deployment"
}

# Log allocation
log_allocation() {
    local peer_name=$1
    local tunnel1=$2
    local tunnel2=$3
    local asn=$4
    local peer_cidr=$5
    local performer=${6:-"unknown"}

    local timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

    echo "[$timestamp] ALLOCATED: $peer_name | Tunnels: $tunnel1, $tunnel2 | ASN: $asn | Peer CIDR: $peer_cidr | By: $performer" >> "$AUDIT_LOG"
}

# Dry run mode
show_help() {
    cat << 'EOF'
Skill: Validate Peer IPs

Purpose: Prevent VPN peer IP collisions and enforce unique allocations

Usage: ./skill-validate-peer-ips [OPTIONS]

Options:
  --peer NAME              Peer name (e.g., "NewPartner-VPN")
  --tunnel1 CIDR          Tunnel 1 inside CIDR (e.g., "169.254.16.0/30")
  --tunnel2 CIDR          Tunnel 2 inside CIDR (e.g., "169.254.17.0/30")
  --asn ASN               BGP ASN (e.g., "65003")
  --peer-cidrs CIDRS      Peer CIDRs comma-separated (e.g., "172.19.0.0/16,172.20.0.0/16")
  --suggest               Show suggested allocations for next peer
  --registry              Show current registry allocations
  --help                  Show this help

Examples:
  ./skill-validate-peer-ips --suggest
    → Shows next available allocations

  ./skill-validate-peer-ips --peer JuniperSRX \
    --tunnel1 169.254.16.0/30 --tunnel2 169.254.17.0/30 \
    --asn 65003 --peer-cidrs 172.19.0.0/16
    → Validates all IPs before adding peer

  ./skill-validate-peer-ips --registry
    → Shows all currently allocated IPs

What It Checks:
  ✓ Inside tunnel CIDR uniqueness (no duplicates)
  ✓ BGP ASN uniqueness (no duplicates)
  ✓ Peer CIDR uniqueness (no duplicates)
  ✓ Reserved ranges (AWS, IANA)
  ✓ Suggests next available allocations
  ✓ Maintains audit log of all allocations

Registry File: vpn-peers-registry.yaml
Audit Log:     vpn-peers-audit.log

CRITICAL: Always validate BEFORE adding new peer to Pulumi config!

EOF
}

# Show registry allocations
show_registry() {
    print_header "Current Registry Allocations"

    echo "Inside Tunnel CIDRs:"
    get_allocated_cidrs | sed 's/^/  /'
    echo ""

    echo "BGP ASNs:"
    get_allocated_asns | sed 's/^/  /'
    echo ""

    echo "Peer CIDRs:"
    get_allocated_peer_cidrs | sed 's/^/  /'
    echo ""

    suggest_allocations
}

# Main execution
main() {
    local peer_name=""
    local tunnel1=""
    local tunnel2=""
    local bgp_asn=""
    local peer_cidrs=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --peer)
                peer_name="$2"
                shift 2
                ;;
            --tunnel1)
                tunnel1="$2"
                shift 2
                ;;
            --tunnel2)
                tunnel2="$2"
                shift 2
                ;;
            --asn)
                bgp_asn="$2"
                shift 2
                ;;
            --peer-cidrs)
                peer_cidrs="$2"
                shift 2
                ;;
            --suggest)
                check_registry
                suggest_allocations
                exit 0
                ;;
            --registry)
                check_registry
                show_registry
                exit 0
                ;;
            --help)
                show_help
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done

    # If no validation requested, show suggestions
    if [ -z "$peer_name" ]; then
        check_registry
        show_registry
        exit 0
    fi

    # Validate provided peer
    check_registry

    print_header "IP Collision Prevention Validation"
    print_status "info" "Validating peer: $peer_name"
    echo ""

    if validate_peer "$peer_name" "$tunnel1" "$tunnel2" "$bgp_asn" "$peer_cidrs"; then
        print_header "Validation Complete"
        print_status "pass" "Safe to add $peer_name to vpn-peers.yaml"
        echo ""
        echo "NEXT STEPS:"
        echo "  1. Add peer config to: aff-atg/vpn-peers.yaml"
        echo "  2. Update registry: aff-atg/vpn-peers-registry.yaml"
        echo "  3. Run: pulumi preview --stack asg-plat-dev"
        echo "  4. Run: pulumi up --stack asg-plat-dev"
        echo "  5. Run: ./skill-vpn-e2e-test --peer $peer_name --e2e"
        echo ""
        log_allocation "$peer_name" "$tunnel1" "$tunnel2" "$bgp_asn" "$peer_cidrs" "${USER:-devops}"
        print_status "pass" "Audit logged: $AUDIT_LOG"
        exit 0
    else
        print_header "Validation Failed"
        print_status "fail" "DO NOT add $peer_name yet"
        echo ""
        echo "FIX ISSUES:"
        echo "  • Use --suggest to get available allocations"
        echo "  • Modify your peer config with available IPs"
        echo "  • Re-run validation"
        exit 1
    fi
}

main "$@"
