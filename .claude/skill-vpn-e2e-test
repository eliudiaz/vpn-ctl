  peer-guides/PALOALTO_SETUP_GUIDE.md
  peer-guides/CISCO_SETUP_GUIDE.md
EOF
}

# Main
case "${1:-}" in
    --peer)
        if [ -z "$2" ]; then
            print_status "fail" "Peer name required: --peer PEER_NAME"
            exit 1
        fi
        PEER_NAME="$2"
        shift 2

        case "${1:-all}" in
            --layer)
                TEST_LAYER="$2"
                case $TEST_LAYER in
                    1) layer_1_reachability ;;
                    2) layer_2_tunnel_state ;;
                    3) layer_3_bgp_routes ;;
                    4) layer_4_traffic_test ;;
                    5) layer_5_redundancy ;;
                    *)
                        print_status "fail" "Invalid layer: $TEST_LAYER (must be 1-5)"
                        exit 1
                        ;;
                esac
                ;;
            --e2e)
                layer_1_reachability
                layer_2_tunnel_state
                layer_3_bgp_routes
                layer_4_traffic_test
                layer_5_redundancy
                check_cloudwatch_metrics
                print_result_summary
                ;;
            *)
                quick_check
                ;;
        esac
        ;;
    --layer)
        TEST_LAYER="$2"
        if [ -z "$PEER_NAME" ]; then
            print_status "fail" "Peer name required for layer testing: --peer PEER_NAME --layer <1-5>"
            exit 1
        fi
        case $TEST_LAYER in
            1) layer_1_reachability ;;
            2) layer_2_tunnel_state ;;
            3) layer_3_bgp_routes ;;
            4) layer_4_traffic_test ;;
            5) layer_5_redundancy ;;
            *)
                print_status "fail" "Invalid layer: $TEST_LAYER (must be 1-5)"
                exit 1
                ;;
        esac
        ;;
    --e2e)
        if [ -z "$PEER_NAME" ]; then
            print_status "fail" "Peer name required for E2E testing: --peer PEER_NAME --e2e"
            exit 1
        fi
        layer_1_reachability
        layer_2_tunnel_state
        layer_3_bgp_routes
        layer_4_traffic_test
        layer_5_redundancy
        check_cloudwatch_metrics
        print_result_summary
        ;;
    --help)
        show_help
        ;;
    *)
        quick_check
        ;;
esac
