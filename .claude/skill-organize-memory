#!/bin/bash

################################################################################
# Memory Organization Skill
# Purpose: Consolidate and organize all markdown files into structured memory
# Creates searchable, categorized memory files from project documentation
################################################################################

set -e

# Configuration
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
MEMORY_DIR="$PROJECT_ROOT/aff-atg/.memory"
DOCS_DIR="$PROJECT_ROOT"

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Logging
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[✓]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $1"; }
log_error() { echo -e "${RED}[✗]${NC} $1"; }

################################################################################
# Discover and Categorize Markdown Files
################################################################################

discover_markdown_files() {
    log_info "Discovering markdown files in $PROJECT_ROOT..."

    # Find all markdown files
    while IFS= read -r file; do
        # Skip node_modules, .git, etc.
        if [[ "$file" =~ node_modules|\.git|\.pytest ]]; then
            continue
        fi

        # Get relative path
        rel_path="${file#$PROJECT_ROOT/}"

        # Determine category based on path
        if [[ "$rel_path" == "docs-"* ]]; then
            category="docs"
        elif [[ "$rel_path" == *"skill"* ]]; then
            category="skills"
        elif [[ "$rel_path" == *"spec"* ]]; then
            category="specs"
        elif [[ "$rel_path" == "README"* ]] || [[ "$rel_path" == "IMPLEMENTATION"* ]]; then
            category="core"
        else
            category="other"
        fi

        echo "$rel_path|$category"
    done < <(find "$PROJECT_ROOT" -name "*.md" -type f 2>/dev/null | sort)
}

################################################################################
# Extract Metadata from Markdown Files
################################################################################

extract_metadata() {
    local file=$1

    # Extract title (first H1 or filename)
    local title=$(grep -m1 "^# " "$file" | sed 's/^# //' || basename "$file" .md)

    # Extract summary (first paragraph)
    local summary=$(grep -v "^#" "$file" | grep -v "^$" | head -3 | tr '\n' ' ')

    # Count lines
    local lines=$(wc -l < "$file")

    # Get modification date
    local mtime=$(stat -f "%Sm" -t "%Y-%m-%d" "$file" 2>/dev/null || date +%Y-%m-%d)

    echo "$title|$summary|$lines|$mtime"
}

################################################################################
# Generate Category Memory Files
################################################################################

generate_category_memory() {
    local target_category=$1
    local memory_file="$MEMORY_DIR/${target_category}-docs.md"

    log_info "Generating memory file: ${target_category}-docs.md"

    cat > "$memory_file" << 'EOF'
# Category Documentation Index

EOF

    discover_markdown_files | while IFS='|' read -r file category; do
        # Skip if wrong category
        [[ "$category" != "$target_category" ]] && continue

        local rel_path="$file"

        # Extract metadata
        local metadata=$(extract_metadata "$PROJECT_ROOT/$rel_path")
        local title=$(echo "$metadata" | cut -d'|' -f1)
        local summary=$(echo "$metadata" | cut -d'|' -f2)
        local lines=$(echo "$metadata" | cut -d'|' -f3)
        local mtime=$(echo "$metadata" | cut -d'|' -f4)

        # Add to memory file
        echo "## $title" >> "$memory_file"
        echo "- **File**: \`$rel_path\`" >> "$memory_file"
        echo "- **Size**: $lines lines | **Updated**: $mtime" >> "$memory_file"
        echo "- **Summary**: $summary" >> "$memory_file"
        echo "" >> "$memory_file"
    done

    log_success "Created: $memory_file"
}

################################################################################
# Generate Search Index
################################################################################

generate_search_index() {
    log_info "Generating search index..."

    local index_file="$MEMORY_DIR/SEARCH-INDEX.md"

    cat > "$index_file" << 'EOF'
# Memory Search Index

Quick reference for all documented topics organized by category.

## By Category

EOF

    # Group files by category
    for cat in docs skills specs core other; do
        echo "### $cat" >> "$index_file"
        discover_markdown_files | while IFS='|' read -r file category; do
            if [[ "$category" == "$cat" ]]; then
                local title=$(grep -m1 "^# " "$PROJECT_ROOT/$file" 2>/dev/null | sed 's/^# //' || basename "$file" .md)
                echo "- [$title]($file)" >> "$index_file"
            fi
        done
        echo "" >> "$index_file"
    done

    log_success "Created: $index_file"
}

################################################################################
# Update Main MEMORY.md
################################################################################

update_memory_index() {
    log_info "Updating MEMORY.md with file index..."

    local memory_file="$MEMORY_DIR/MEMORY.md"

    # Create backup
    cp "$memory_file" "$memory_file.backup" 2>/dev/null || true

    # Count files by type
    local md_count=$(find "$PROJECT_ROOT" -name "*.md" -type f 2>/dev/null | wc -l)
    local skill_count=$(find "$PROJECT_ROOT" -name "skill-*" -type f 2>/dev/null | wc -l)

    # Add index section at top if not exists
    if ! grep -q "## Memory Organization Index" "$memory_file"; then
        cat > "$memory_file.tmp" << EOF
## Memory Organization Index

**Project Documentation Stats:**
- Markdown Files: $md_count
- Skills: $skill_count
- Memory Files: $(ls -1 "$MEMORY_DIR"/*.md 2>/dev/null | wc -l)

**Quick Links:**
- [docs-docs.md](docs-docs.md) - Documentation files
- [skills-docs.md](skills-docs.md) - Skill scripts
- [specs-docs.md](specs-docs.md) - Specification files
- [core-docs.md](core-docs.md) - Core documentation
- [SEARCH-INDEX.md](SEARCH-INDEX.md) - Full search index

**Last Updated:** $(date +%Y-%m-%d)

---

EOF
        cat "$memory_file" >> "$memory_file.tmp"
        mv "$memory_file.tmp" "$memory_file"
    fi

    log_success "Updated MEMORY.md index"
}

################################################################################
# Generate Quick Reference
################################################################################

generate_quick_reference() {
    log_info "Generating quick reference..."

    local qref_file="$MEMORY_DIR/QUICK-REFERENCE.md"

    cat > "$qref_file" << 'EOF'
# Quick Reference Guide

## Documentation Organization

### By Component
- **ATG (Transit Gateway)**: VPN configuration, routing, connectivity
- **EKS Integration**: Cluster connectivity, node networking
- **RabbitMQ**: Message broker, continuous drainer
- **Skills**: Automated testing, diagnostics, troubleshooting
- **Infrastructure**: AWS resources, networking, security

### By Topic
- **VPN Setup**: Configuration, deployment, testing
- **Networking**: Transit Gateway, routing, CIDR management
- **Operations**: Monitoring, health checks, troubleshooting
- **Automation**: Scripts, skills, diagnostic tools

## Common Tasks

### Find documentation about topic X
→ Check [SEARCH-INDEX.md](SEARCH-INDEX.md)

### Find a specific skill
→ Look in skills-docs.md or search `skill-` prefix

### Find spec/architecture details
→ Check specs-docs.md or docs-core/

### Update memory with new files
→ Run: `skill-organize-memory --update`

## File Organization Rules

1. **Documentation files** → docs-*/ folders
2. **Specification files** → *spec.md naming
3. **Skills/scripts** → skill-* prefix
4. **Implementation guides** → IMPLEMENTATION_*.md
5. **Guides** → *GUIDE.md or README.md

## Memory Maintenance

- Run skill monthly to refresh organization
- Archive old/deprecated docs to docs-archive/
- Keep MEMORY.md under 200 lines (move details to topic files)
- Link topic files from MEMORY.md for reference

---

**Last Generated:** $(date +%Y-%m-%d)

EOF

    log_success "Created: $qref_file"
}

################################################################################
# Main Operations
################################################################################

main() {
    local action="${1:-analyze}"

    case "$action" in
        --analyze|analyze)
            log_info "Analyzing markdown files..."
            discover_markdown_files | head -20
            echo "..."
            ;;

        --update|update)
            log_info "Updating memory organization..."
            mkdir -p "$MEMORY_DIR"

            # Generate category files
            for cat in docs skills specs core other; do
                generate_category_memory "$cat" < <(discover_markdown_files)
            done

            # Generate indexes
            generate_search_index
            update_memory_index
            generate_quick_reference

            log_success "Memory organization complete!"
            log_info "Files created in: $MEMORY_DIR"
            ;;

        --stats|stats)
            log_info "Documentation Statistics:"
            echo ""

            local total=$(find "$PROJECT_ROOT" -name "*.md" -type f 2>/dev/null | wc -l)
            echo "Total MD files: $total"
            echo ""

            echo "By Category:"
            find "$PROJECT_ROOT" -name "*.md" -type f 2>/dev/null | while read file; do
                if [[ "$file" =~ docs- ]]; then echo "  docs: $file"; fi
            done | sort | uniq -c

            echo ""
            echo "Memory directory size: $(du -sh "$MEMORY_DIR" 2>/dev/null || echo 'N/A')"
            ;;

        --help|help|-h)
            cat << 'HELP'
Memory Organization Skill - Organize markdown files into searchable memory

Usage: skill-organize-memory [COMMAND]

Commands:
  --analyze    Analyze and display markdown file structure
  --update     Update memory files and indexes
  --stats      Show documentation statistics
  --help       Show this help message

Features:
  - Discovers all markdown files in project
  - Extracts metadata (title, summary, size, date)
  - Generates category-based memory files
  - Creates searchable index
  - Maintains MEMORY.md index
  - Generates quick reference guide

Examples:
  skill-organize-memory --analyze          # See file structure
  skill-organize-memory --update           # Refresh all memory files
  skill-organize-memory --stats            # View statistics

Output:
  Memory files created in: /Users/eliudiaz/.claude/projects/.../memory/
  - docs-docs.md
  - skills-docs.md
  - specs-docs.md
  - SEARCH-INDEX.md
  - QUICK-REFERENCE.md
HELP
            ;;

        *)
            log_error "Unknown command: $action"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
}

main "$@"
