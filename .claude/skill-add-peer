# Main execution
main() {
    print_header "Affinity ATG - Add New VPN Peer"

    # Check if vpn-peers.yaml exists
    if [ ! -f "$VPNPEERS_FILE" ]; then
        print_status "fail" "vpn-peers.yaml not found"
        exit 1
    fi

    # Prompt for peer information
    prompt_peer_info

    # Generate PSKs
    echo ""
    generate_psks

    # Generate tunnel details
    generate_tunnel_details

    # Show configuration preview
    echo ""
    show_configuration_preview

    # Confirm before applying
    confirm_application

    # Add to vpn-peers.yaml
    echo ""
    add_to_vpn_peers

    # Deploy with Pulumi
    echo ""
    deploy_with_pulumi

    # Verify peer creation
    echo ""
    verify_peer

    # Show next steps
    echo ""
    show_next_steps
}

# Entry point
case "${1:-}" in
    --help|-h)
        show_help
        ;;
    *)
        main
        ;;
esac
