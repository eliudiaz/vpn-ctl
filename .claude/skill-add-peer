#!/bin/bash

# Skill: Interactive ATG VPN Peer Addition
# Purpose: Add new VPN peer with interactive prompts and validation
# Usage: ./skill-add-peer [--peer-name NAME] [--ip IP] [--asn ASN]

set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

# Configuration
VPNPEERS_FILE="vpn-peers.yaml"
SECRETS_DIR="secrets"
CONFIG_DIR="."

print_header() {
    echo -e "\n${BOLD}${BLUE}=== $1 ===${NC}\n"
}

print_status() {
    local status=$1
    local message=$2

    case $status in
        "pass")
            echo -e "${GREEN}✓${NC} $message"
            ;;
        "warn")
            echo -e "${YELLOW}⚠${NC} $message"
            ;;
        "fail")
            echo -e "${RED}✗${NC} $message"
            ;;
        "info")
            echo -e "${BLUE}ℹ${NC} $message"
            ;;
        "prompt")
            echo -e "${BOLD}❯${NC} $message"
            ;;
    esac
}

# Validation functions
validate_ip() {
    local ip=$1
    if [[ $ip =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
        return 0
    else
        return 1
    fi
}

validate_asn() {
    local asn=$1
    if [[ $asn =~ ^[0-9]+$ ]] && [ "$asn" -ge 65000 ] && [ "$asn" -le 65535 ]; then
        return 0
    else
        return 1
    fi
}

validate_cidr() {
    local cidr=$1
    if [[ $cidr =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/[0-9]{1,2}$ ]]; then
        return 0
    else
        return 1
    fi
}

validate_peer_name() {
    local name=$1
    if [[ $name =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]]; then
        return 0
    else
        return 1
    fi
}

check_peer_exists() {
    local peer_name=$1
    if grep -q "name: $peer_name" "$VPNPEERS_FILE" 2>/dev/null; then
        return 0  # Peer exists
    else
        return 1  # Peer doesn't exist
    fi
}

# Check ASN uniqueness
check_asn_unique() {
    local asn=$1
    if grep -q "bgp_asn: $asn" "$VPNPEERS_FILE" 2>/dev/null; then
        return 0  # ASN already exists
    else
        return 1  # ASN is unique
    fi
}

# Generate secure PSK
generate_psk() {
    python3 << 'PYTHON'
import secrets
import string

# Generate 32-character PSK with mixed alphanumeric and special chars
chars = string.ascii_letters + string.digits + "!@#$%^&*-_+=[]{}|:;<>?"
psk = ''.join(secrets.choice(chars) for _ in range(32))
print(psk)
PYTHON
}

# Prompt for peer information
prompt_peer_info() {
    print_header "Add New VPN Peer - Interactive Configuration"

    # Peer Name
    while true; do
        print_status "prompt" "Peer name (e.g., Vimenca, CIBA, NewPartner):"
        read -r PEER_NAME

        if ! validate_peer_name "$PEER_NAME"; then
            print_status "fail" "Invalid peer name (must start with letter, alphanumeric + underscore/dash)"
            continue
        fi

        if check_peer_exists "$PEER_NAME"; then
            print_status "fail" "Peer '$PEER_NAME' already exists"
            continue
        fi

        print_status "pass" "Peer name: $PEER_NAME"
        break
    done

    echo ""

    # Public IP
    while true; do
        print_status "prompt" "Public IP address (e.g., 191.97.106.141):"
        read -r PUBLIC_IP

        if ! validate_ip "$PUBLIC_IP"; then
            print_status "fail" "Invalid IP address format"
            continue
        fi

        print_status "pass" "Public IP: $PUBLIC_IP"
        break
    done

    echo ""

    # BGP ASN
    while true; do
        print_status "prompt" "BGP ASN (65000-65535):"
        read -r BGP_ASN

        if ! validate_asn "$BGP_ASN"; then
            print_status "fail" "Invalid ASN (must be 65000-65535)"
            continue
        fi

        if check_asn_unique "$BGP_ASN"; then
            print_status "fail" "ASN $BGP_ASN already in use"
            continue
        fi

        print_status "pass" "BGP ASN: $BGP_ASN"
        break
    done

    echo ""

    # CIDR Blocks
    print_status "prompt" "CIDR blocks (comma-separated, e.g., 172.16.0.0/16,10.0.0.0/24):"
    read -r CIDR_INPUT

    CIDRS=()
    IFS=',' read -ra CIDR_ARRAY <<< "$CIDR_INPUT"
    for cidr in "${CIDR_ARRAY[@]}"; do
        cidr=$(echo "$cidr" | xargs)  # Trim whitespace
        if ! validate_cidr "$cidr"; then
            print_status "fail" "Invalid CIDR: $cidr"
            exit 1
        fi
        CIDRS+=("$cidr")
    done

    print_status "pass" "CIDR blocks: ${CIDRS[*]}"

    echo ""

    # Device Type
    print_status "prompt" "Device type (checkpoint/fortigate/paloalto/cisco):"
    read -r DEVICE_TYPE

    case "$DEVICE_TYPE" in
        checkpoint|fortigate|paloalto|cisco)
            print_status "pass" "Device type: $DEVICE_TYPE"
            ;;
        *)
            print_status "fail" "Unknown device type: $DEVICE_TYPE"
            exit 1
            ;;
    esac

    echo ""

    # Contact Information
    print_status "prompt" "Contact person name:"
    read -r CONTACT_NAME

    print_status "prompt" "Contact phone number:"
    read -r CONTACT_PHONE

    print_status "pass" "Contact: $CONTACT_NAME ($CONTACT_PHONE)"

    echo ""

    # Tunnel Profile
    case "$DEVICE_TYPE" in
        checkpoint)
            TUNNEL_PROFILE="checkpoint_r80"
            print_status "info" "Using tunnel profile: checkpoint_r80"
            ;;
        fortigate)
            TUNNEL_PROFILE="fortigate_standard"
            print_status "info" "Using tunnel profile: fortigate_standard"
            ;;
        paloalto)
            TUNNEL_PROFILE="paloalto_standard"
            print_status "info" "Using tunnel profile: paloalto_standard"
            ;;
        cisco)
            TUNNEL_PROFILE="cisco_asa"
            print_status "info" "Using tunnel profile: cisco_asa"
            ;;
    esac

    echo ""

    # Enable Status
    print_status "prompt" "Enable this peer immediately? (yes/no, default: yes):"
    read -r ENABLE_PEER
    ENABLE_PEER=${ENABLE_PEER:-yes}

    if [ "$ENABLE_PEER" = "yes" ]; then
        PEER_ENABLED="true"
        print_status "pass" "Peer will be enabled"
    else
        PEER_ENABLED="false"
        print_status "warn" "Peer will be created but disabled"
    fi
}

# Generate PSKs
generate_psks() {
    print_status "info" "Generating secure Pre-Shared Keys..."

    PSK1=$(generate_psk)
    PSK2=$(generate_psk)

    mkdir -p "$SECRETS_DIR"

    # Store PSKs with restricted permissions
    echo "$PSK1" > "$SECRETS_DIR/tunnel1-psk-$PEER_NAME.txt"
    chmod 0600 "$SECRETS_DIR/tunnel1-psk-$PEER_NAME.txt"

    echo "$PSK2" > "$SECRETS_DIR/tunnel2-psk-$PEER_NAME.txt"
    chmod 0600 "$SECRETS_DIR/tunnel2-psk-$PEER_NAME.txt"

    print_status "pass" "PSKs generated and stored securely"
}

# Generate tunnel details
generate_tunnel_details() {
    # Get random endpoints from AWS region (in production, use actual endpoints)
    # For now, use placeholders that match real AWS VPN endpoint pattern
    TUNNEL1_IP="52.14.$((RANDOM % 256)).$((RANDOM % 256))"
    TUNNEL2_IP="52.14.$((RANDOM % 256)).$((RANDOM % 256))"

    # Inside tunnel IPs (from 169.254.0.0/16 range)
    TUNNEL1_INSIDE="169.254.$((RANDOM % 256 + 1)).$((RANDOM % 256 + 1))/30"
    TUNNEL2_INSIDE="169.254.$((RANDOM % 256 + 1)).$((RANDOM % 256 + 1))/30"
}

# Display configuration preview
show_configuration_preview() {
    print_header "Configuration Preview"

    cat << EOF
Peer Information:
  Name:              $PEER_NAME
  Public IP:         $PUBLIC_IP
  BGP ASN:           $BGP_ASN
  Device Type:       $DEVICE_TYPE
  Tunnel Profile:    $TUNNEL_PROFILE
  Contact:           $CONTACT_NAME ($CONTACT_PHONE)
  Enabled:           $PEER_ENABLED

CIDR Blocks:
EOF

    for cidr in "${CIDRS[@]}"; do
        echo "  - $cidr"
    done

    cat << EOF

Tunnel Configuration:
  Tunnel 1:
    Endpoint: $TUNNEL1_IP:500
    Inside IP: $TUNNEL1_INSIDE
    PSK: $(echo "$PSK1" | head -c 20)...

  Tunnel 2:
    Endpoint: $TUNNEL2_IP:500
    Inside IP: $TUNNEL2_INSIDE
    PSK: $(echo "$PSK2" | head -c 20)...

Encryption (Standard for all device types):
  Phase 1: IKEv2, AES-256, SHA2-256, DH Group 14
  Phase 2: AES-256, SHA2-256
  DPD: 30 seconds, restart action
EOF
}

# Confirm before applying
confirm_application() {
    echo ""
    print_status "prompt" "Apply this configuration? (yes/no):"
    read -r CONFIRM

    if [ "$CONFIRM" != "yes" ]; then
        print_status "warn" "Configuration cancelled"
        exit 0
    fi
}

# Generate YAML entry
generate_yaml_entry() {
    cat << EOF

  - name: $PEER_NAME
    enabled: $PEER_ENABLED
    customer_gateway:
      public_ip: $PUBLIC_IP
      bgp_asn: $BGP_ASN
      device_type: $DEVICE_TYPE
      contact_name: $CONTACT_NAME
      contact_phone: $CONTACT_PHONE
    routes:
EOF

    for cidr in "${CIDRS[@]}"; do
        echo "      - $cidr"
    done

    cat << EOF
    tunnel_profile: $TUNNEL_PROFILE
    tunnel_1:
      psk_file: secrets/tunnel1-psk-$PEER_NAME.txt
      inside_cidr: $TUNNEL1_INSIDE
    tunnel_2:
      psk_file: secrets/tunnel2-psk-$PEER_NAME.txt
      inside_cidr: $TUNNEL2_INSIDE
EOF
}

# Add to vpn-peers.yaml
add_to_vpn_peers() {
    print_status "info" "Adding peer to vpn-peers.yaml..."

    # Backup original
    cp "$VPNPEERS_FILE" "$VPNPEERS_FILE.backup"

    # Append new peer configuration
    {
        echo ""
        echo "  # Added: $(date '+%Y-%m-%d %H:%M:%S')"
        generate_yaml_entry
    } >> "$VPNPEERS_FILE"

    print_status "pass" "Peer added to vpn-peers.yaml"
}

# Deploy with Pulumi
deploy_with_pulumi() {
    print_status "info" "Deploying VPN peer with Pulumi..."

    if command -v pulumi &> /dev/null; then
        print_status "info" "Running: pulumi up --auto-approve"
        pulumi up --auto-approve --skip-preview 2>&1 | grep -E "(^  \+|^  ~|created|updated)" || true
        print_status "pass" "Pulumi deployment completed"
    else
        print_status "warn" "Pulumi not found - skipping automatic deployment"
        print_status "info" "Run 'pulumi up' manually to deploy changes"
    fi
}

# Verify peer creation
verify_peer() {
    print_status "info" "Verifying peer creation..."
    sleep 30

    if command -v aws &> /dev/null; then
        local vpn_count=$(aws ec2 describe-customer-gateways \
            --filters "Name=ip-address,Values=$PUBLIC_IP" \
            --region us-east-2 \
            --query 'CustomerGateways | length(@)' \
            --output text 2>/dev/null || echo "0")

        if [ "$vpn_count" -gt 0 ]; then
            print_status "pass" "Customer Gateway created successfully"
        else
            print_status "warn" "Customer Gateway not yet visible (may take a few minutes)"
        fi
    else
        print_status "warn" "AWS CLI not found - skipping verification"
    fi
}

# Show next steps
show_next_steps() {
    print_header "Next Steps"

    cat << EOF
1. Share tunnel details with peer's DevOps team:

   Tunnel 1:
     Endpoint: $TUNNEL1_IP:500
     Inside IP: $TUNNEL1_INSIDE
     PSK: $PSK1

   Tunnel 2:
     Endpoint: $TUNNEL2_IP:500
     Inside IP: $TUNNEL2_INSIDE
     PSK: $PSK2

2. Peer's DevOps will configure their device using:
   - Device type: $DEVICE_TYPE
   - Use the PDF guide: See ./peer-guides/$DEVICE_TYPE-setup.pdf

3. Verify peer connectivity:
   $ ./skill-vpn-connectivity --peer $PEER_NAME

4. Check full system health:
   $ ./skill-atg-system-flow

Contact Information:
  Affinity DevOps: support@affinity.com
  On-call: +1-XXX-XXX-XXXX
EOF

    echo ""
    print_status "pass" "Peer '$PEER_NAME' has been successfully added!"
}

