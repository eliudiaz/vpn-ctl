#!/bin/bash
# skill-post-deployment-verify
# Automated post-deployment verification for Vimenca VPN + EKS routing
#
# Runs after "pulumi up" to ensure:
# 1. TGW routes exist and are ACTIVE
# 2. VPC routes exist in all EKS route tables
# 3. Pod networking can reach Vimenca URLs
# 4. Returns exit code 0 (PASS) or 1 (FAIL)
#
# Usage:
#   ./skill-post-deployment-verify
#   ./skill-post-deployment-verify --verbose
#   ./skill-post-deployment-verify --format json

set -o pipefail

# Configuration
AWS_PROFILE="affinity"
AWS_REGION="us-east-2"
CLUSTER_NAME="asg-plat-dev"
TGW_RTB_ID="tgw-rtb-079e9cb450e5355e6"
REQUIRED_CIDRS=("172.16.70.0/24" "172.16.65.21/32" "172.16.82.0/24" "203.0.113.10/32")

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Configuration
VERBOSE=false
FORMAT="text"
PASSED_CHECKS=0
FAILED_CHECKS=0
declare -A CHECK_RESULTS

log_info() {
    if [ "$VERBOSE" = true ]; then
        echo -e "${BLUE}ℹ${NC} $1" >&2
    fi
}

log_pass() {
    echo -e "${GREEN}✔${NC} $1" >&2
    ((PASSED_CHECKS++))
}

log_fail() {
    echo -e "${RED}✘${NC} $1" >&2
    ((FAILED_CHECKS++))
}

log_warn() {
    echo -e "${YELLOW}⚠${NC} $1" >&2
}

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --verbose)
            VERBOSE=true
            shift
            ;;
        --format)
            FORMAT="$2"
            shift 2
            ;;
        --help)
            cat << 'HELP'
Usage: skill-post-deployment-verify [OPTIONS]

Post-deployment verification for Vimenca VPN + EKS routing.
Validates TGW routes, VPC routes, and pod connectivity.

Options:
  --verbose      Show detailed logs
  --format json  Output results as JSON
  --help         Show this help

Exit Codes:
  0 = PASS (all checks succeeded)
  1 = FAIL (one or more checks failed)
  2 = ERROR (script execution error)

HELP
            exit 0
            ;;
        *)
            log_fail "Unknown option: $1"
            exit 2
            ;;
    esac
done

log_info "Starting post-deployment verification..."
log_info "Cluster: $CLUSTER_NAME"
log_info "Region: $AWS_REGION"
log_info "Profile: $AWS_PROFILE"

# =============================================================================
# Phase 1: Verify AWS Authentication
# =============================================================================

log_info "Checking AWS authentication..."
if ! aws sts get-caller-identity --profile "$AWS_PROFILE" &>/dev/null; then
    log_fail "AWS authentication failed with profile '$AWS_PROFILE'"
    exit 2
fi
log_pass "AWS authentication successful"
CHECK_RESULTS["aws_auth"]="PASS"

# =============================================================================
# Phase 2: Verify TGW Routes
# =============================================================================

log_info "Validating TGW routes..."

# Check if TGW route table exists
if [ -z "$TGW_RTB_ID" ]; then
    log_warn "TGW route table ID not configured (using default)"
    TGW_RTB_ID=$(aws ec2 describe-transit-gateway-route-tables \
        --profile "$AWS_PROFILE" --region "$AWS_REGION" \
        --query 'TransitGatewayRouteTables[0].TransitGatewayRouteTableId' \
        --output text 2>/dev/null || echo "")
fi

if [ -z "$TGW_RTB_ID" ] || [ "$TGW_RTB_ID" = "None" ]; then
    log_fail "Could not determine TGW route table ID"
    CHECK_RESULTS["tgw_routes"]="FAIL"
else
    TGW_ROUTES_OK=true

    for cidr in "${REQUIRED_CIDRS[@]}"; do
        ROUTE_STATE=$(aws ec2 search-transit-gateway-routes \
            --profile "$AWS_PROFILE" --region "$AWS_REGION" \
            --transit-gateway-route-table-id "$TGW_RTB_ID" \
            --filters "Name=state,Values=active,blackholed" \
            --query "Routes[?DestinationCidrBlock=='$cidr'].State" \
            --output text 2>/dev/null || echo "")

        if [ "$ROUTE_STATE" = "active" ]; then
            log_pass "TGW route $cidr is ACTIVE"
        elif [ -n "$ROUTE_STATE" ]; then
            log_warn "TGW route $cidr state: $ROUTE_STATE (not active yet)"
            TGW_ROUTES_OK=false
        else
            log_fail "TGW route $cidr NOT FOUND"
            TGW_ROUTES_OK=false
        fi
    done

    if [ "$TGW_ROUTES_OK" = true ]; then
        log_pass "All TGW routes verified"
        CHECK_RESULTS["tgw_routes"]="PASS"
    else
        log_fail "Some TGW routes missing or inactive"
        CHECK_RESULTS["tgw_routes"]="FAIL"
    fi
fi

# =============================================================================
# Phase 3: Verify VPC Routes
# =============================================================================

log_info "Validating VPC routes..."

# Get cluster VPC
CLUSTER_VPC=$(aws eks describe-cluster \
    --profile "$AWS_PROFILE" --region "$AWS_REGION" \
    --name "$CLUSTER_NAME" \
    --query 'cluster.resourcesVpcConfig.vpcId' \
    --output text 2>/dev/null || echo "")

if [ -z "$CLUSTER_VPC" ] || [ "$CLUSTER_VPC" = "None" ]; then
    log_fail "Could not determine cluster VPC"
    CHECK_RESULTS["vpc_routes"]="FAIL"
else
    log_pass "Found cluster VPC: $CLUSTER_VPC"

    # Get route tables
    VPC_ROUTE_TABLES=$(aws ec2 describe-route-tables \
        --profile "$AWS_PROFILE" --region "$AWS_REGION" \
        --filters "Name=vpc-id,Values=$CLUSTER_VPC" \
        --query 'RouteTables[*].RouteTableId' \
        --output text 2>/dev/null || echo "")

    if [ -z "$VPC_ROUTE_TABLES" ]; then
        log_fail "No route tables found in VPC"
        CHECK_RESULTS["vpc_routes"]="FAIL"
    else
        VPC_ROUTES_OK=true
        ROUTE_COUNT=0

        for rtb_id in $VPC_ROUTE_TABLES; do
            for cidr in "${REQUIRED_CIDRS[@]}"; do
                ROUTE_EXISTS=$(aws ec2 describe-route-tables \
                    --profile "$AWS_PROFILE" --region "$AWS_REGION" \
                    --route-table-ids "$rtb_id" \
                    --query "RouteTables[0].Routes[?DestinationCidrBlock=='$cidr' && TransitGatewayId!=null]" \
                    --output text 2>/dev/null | wc -l)

                if [ "$ROUTE_EXISTS" -gt 0 ]; then
                    ((ROUTE_COUNT++))
                else
                    log_warn "VPC route $cidr NOT in $rtb_id"
                    VPC_ROUTES_OK=false
                fi
            done
        done

        log_info "Found $ROUTE_COUNT route entries across all route tables"

        if [ "$VPC_ROUTES_OK" = true ] && [ "$ROUTE_COUNT" -gt 0 ]; then
            log_pass "All VPC routes verified"
            CHECK_RESULTS["vpc_routes"]="PASS"
        else
            log_warn "Some VPC routes missing (Phase 2 might not have executed)"
            CHECK_RESULTS["vpc_routes"]="WARN"
        fi
    fi
fi

# =============================================================================
# Phase 4: Pod Connectivity Test
# =============================================================================

log_info "Testing pod connectivity..."

# Check if skill-test-pod-connectivity exists
if [ ! -f "scripts/skill-test-pod-connectivity" ]; then
    log_warn "skill-test-pod-connectivity not found, skipping pod tests"
    CHECK_RESULTS["pod_tests"]="SKIP"
else
    # Run pod connectivity test
    log_info "Running skill-test-pod-connectivity..."

    if SKILL_OUTPUT=$(./scripts/skill-test-pod-connectivity Vimenca --format json 2>&1); then
        HEALTH_SCORE=$(echo "$SKILL_OUTPUT" | jq -r '.health_score // 0')
        URL_PASSED=$(echo "$SKILL_OUTPUT" | jq -r '.url_tests.passed // 0')
        URL_TOTAL=$(echo "$SKILL_OUTPUT" | jq -r '.url_tests.total // 0')

        log_info "Pod connectivity health score: $HEALTH_SCORE%"
        log_info "URLs passed: $URL_PASSED / $URL_TOTAL"

        if [ "$HEALTH_SCORE" -ge 80 ]; then
            log_pass "Pod connectivity verified ($HEALTH_SCORE% health)"
            CHECK_RESULTS["pod_tests"]="PASS"
        elif [ "$HEALTH_SCORE" -ge 50 ]; then
            log_warn "Pod connectivity degraded ($HEALTH_SCORE% health)"
            CHECK_RESULTS["pod_tests"]="WARN"
        else
            log_fail "Pod connectivity failed ($HEALTH_SCORE% health)"
            CHECK_RESULTS["pod_tests"]="FAIL"
        fi
    else
        log_warn "Could not run pod connectivity test (kubectl might not be available)"
        CHECK_RESULTS["pod_tests"]="SKIP"
    fi
fi

# =============================================================================
# Phase 5: Summary and Output
# =============================================================================

TOTAL_CHECKS=$((PASSED_CHECKS + FAILED_CHECKS))
if [ "$TOTAL_CHECKS" -gt 0 ]; then
    PASS_RATE=$((PASSED_CHECKS * 100 / TOTAL_CHECKS))
else
    PASS_RATE=0
fi

if [ "$FORMAT" = "json" ]; then
    # JSON output
    cat << EOF
{
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "cluster": "$CLUSTER_NAME",
  "region": "$AWS_REGION",
  "checks": {
    "aws_auth": "${CHECK_RESULTS['aws_auth']:-SKIP}",
    "tgw_routes": "${CHECK_RESULTS['tgw_routes']:-SKIP}",
    "vpc_routes": "${CHECK_RESULTS['vpc_routes']:-SKIP}",
    "pod_tests": "${CHECK_RESULTS['pod_tests']:-SKIP}"
  },
  "summary": {
    "passed": $PASSED_CHECKS,
    "failed": $FAILED_CHECKS,
    "pass_rate": $PASS_RATE
  },
  "status": "$([ "$FAILED_CHECKS" -eq 0 ] && echo "PASS" || echo "FAIL")"
}
EOF
else
    # Text output
    echo ""
    echo "┌──────────────────────────────────────────────────────────────────────────┐"
    echo "│ POST-DEPLOYMENT VERIFICATION RESULTS                                     │"
    echo "├──────────────────────────────────────────────────────────────────────────┤"
    echo "│"
    echo "│ Checks:"
    echo "│   AWS Auth:      ${CHECK_RESULTS['aws_auth']:-SKIP}"
    echo "│   TGW Routes:    ${CHECK_RESULTS['tgw_routes']:-SKIP}"
    echo "│   VPC Routes:    ${CHECK_RESULTS['vpc_routes']:-SKIP}"
    echo "│   Pod Tests:     ${CHECK_RESULTS['pod_tests']:-SKIP}"
    echo "│"
    echo "│ Summary:"
    echo "│   Passed:  $PASSED_CHECKS"
    echo "│   Failed:  $FAILED_CHECKS"
    echo "│   Rate:    $PASS_RATE%"
    echo "│"

    if [ "$FAILED_CHECKS" -eq 0 ]; then
        echo "│ Status: $(echo -e "${GREEN}✔ PASS${NC}") - Ready for production"
    else
        echo "│ Status: $(echo -e "${RED}✘ FAIL${NC}") - See errors above"
    fi

    echo "│"
    echo "└──────────────────────────────────────────────────────────────────────────┘"
    echo ""
fi

# Exit with appropriate code
if [ "$FAILED_CHECKS" -eq 0 ]; then
    exit 0
else
    exit 1
fi
