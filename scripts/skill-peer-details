#!/usr/bin/env python3
"""
skill-peer-details: Get comprehensive details about a VPN peer

Shows all configuration, status, and operational details for a peer.

Usage:
  ./skill-peer-details Vimenca              # Get all details
  ./skill-peer-details CIBAO --format json  # JSON format
  ./skill-peer-details Vimenca --live       # Include live AWS status
  ./skill-peer-details --list               # List all peers
  ./skill-peer-details --help               # Help

Output:
  • Configuration details (device type, BGP ASN, CIDRs)
  • IP allocations (tunnel inside IPs)
  • Network ranges (peer and Affinity CIDRs)
  • Live status (if --live flag used)
  • Tunnel endpoints (if --live flag used)
"""

import sys
import yaml
import json
import argparse
import boto3
from pathlib import Path
from datetime import datetime
from typing import Dict, Optional

# Colors
GREEN = '\033[0;32m'
RED = '\033[0;31m'
YELLOW = '\033[1;33m'
BLUE = '\033[0;34m'
BOLD = '\033[1m'
NC = '\033[0m'


class PeerDetails:
    """Get comprehensive peer information"""

    def __init__(self, registry_path=None, region="us-east-2", profile="affinity"):
        """Initialize with registry and AWS session"""
        if registry_path is None:
            registry_path = Path(__file__).parent.parent / "vpn-peers-registry.yaml"

        self.registry_path = registry_path
        self.registry = self._load_registry()
        self.region = region
        self.profile = profile
        self.aws_status = {}

    def _load_registry(self) -> dict:
        """Load peer registry"""
        try:
            with open(self.registry_path) as f:
                registry = yaml.safe_load(f) or {}
                return registry
        except FileNotFoundError:
            print(f"{RED}✗{NC} Registry not found: {self.registry_path}")
            sys.exit(1)
        except yaml.YAMLError as e:
            print(f"{RED}✗{NC} Error parsing registry: {e}")
            sys.exit(1)

    def get_all_peers(self) -> list:
        """Get list of all configured peers"""
        peers = self.registry.get("peers", {})
        peer_list = []
        for key, data in peers.items():
            peer_list.append({
                "key": key,
                "name": data.get("peer_name"),
                "type": data.get("peer_type"),
                "status": data.get("status"),
            })
        return peer_list

    def get_peer_details(self, peer_name: str) -> Optional[Dict]:
        """Get configuration details for a specific peer"""
        peers = self.registry.get("peers", {})

        # Find peer by name (case-insensitive)
        peer_data = None
        peer_key = None
        for key, data in peers.items():
            if data.get("peer_name", "").lower() == peer_name.lower():
                peer_data = data
                peer_key = key
                break

        if not peer_data:
            return None

        return {
            "key": peer_key,
            "name": peer_data.get("peer_name"),
            "device_type": peer_data.get("peer_type"),
            "status": peer_data.get("status"),
            "added_date": peer_data.get("added_date"),
            "bgp": peer_data.get("bgp", {}),
            "tunnel_1": peer_data.get("tunnel_1", {}),
            "tunnel_2": peer_data.get("tunnel_2", {}),
            "peer_cidrs": peer_data.get("peer_cidrs", []),
            "aws_cidrs": peer_data.get("aws_cidrs", []),
        }

    def get_live_aws_status(self, peer_name: str) -> Optional[Dict]:
        """Get live status from AWS"""
        try:
            session = boto3.Session(profile_name=self.profile)
            ec2 = session.client("ec2", region_name=self.region)

            vpn_response = ec2.describe_vpn_connections()
            vpns = vpn_response.get("VpnConnections", [])

            for vpn in vpns:
                # Check tags for peer name
                for tag in vpn.get("Tags", []):
                    if tag["Key"] == "Name" and peer_name.lower() in tag["Value"].lower():
                        return {
                            "vpn_id": vpn["VpnConnectionId"],
                            "state": vpn["State"],
                            "customer_gateway_id": vpn.get("CustomerGatewayId"),
                            "tunnel_1": {
                                "status": vpn["VgwTelemetry"][0]["Status"] if len(vpn.get("VgwTelemetry", [])) > 0 else "UNKNOWN",
                                "outside_ip": vpn["VgwTelemetry"][0].get("OutsideIpAddress", "N/A") if len(vpn.get("VgwTelemetry", [])) > 0 else "N/A",
                                "status_message": vpn["VgwTelemetry"][0].get("StatusMessage", "") if len(vpn.get("VgwTelemetry", [])) > 0 else "",
                            },
                            "tunnel_2": {
                                "status": vpn["VgwTelemetry"][1]["Status"] if len(vpn.get("VgwTelemetry", [])) > 1 else "UNKNOWN",
                                "outside_ip": vpn["VgwTelemetry"][1].get("OutsideIpAddress", "N/A") if len(vpn.get("VgwTelemetry", [])) > 1 else "N/A",
                                "status_message": vpn["VgwTelemetry"][1].get("StatusMessage", "") if len(vpn.get("VgwTelemetry", [])) > 1 else "",
                            },
                        }

            return None
        except Exception as e:
            print(f"{YELLOW}⚠{NC} Could not fetch AWS status: {e}")
            return None

    def print_peer_report(self, peer_name: str, include_live: bool = False):
        """Print comprehensive peer report"""
        details = self.get_peer_details(peer_name)

        if not details:
            print(f"{RED}✗{NC} Peer '{peer_name}' not found in registry")
            print(f"   Available peers: {', '.join([p['name'] for p in self.get_all_peers()])}")
            sys.exit(1)

        # Get live AWS status if requested
        aws_status = None
        if include_live:
            aws_status = self.get_live_aws_status(peer_name)

        print(f"\n{BOLD}{BLUE}=== VPN Peer Details: {details['name']} ==={NC}\n")

        # Basic Info
        print(f"{BOLD}Basic Information{NC}")
        print("-" * 70)
        print(f"Peer Name: {details['name']}")
        print(f"Device Type: {details['device_type'].capitalize()}")
        print(f"Status: {details['status']}")
        print(f"Added Date: {details['added_date']}")
        print()

        # BGP Configuration
        print(f"{BOLD}BGP Configuration{NC}")
        print("-" * 70)
        bgp = details.get("bgp", {})
        print(f"Peer BGP ASN: {bgp.get('peer_asn', 'N/A')}")
        print(f"AWS BGP ASN: {bgp.get('aws_asn', 'N/A')}")
        print()

        # Tunnel 1
        print(f"{BOLD}Tunnel 1{NC}")
        print("-" * 70)
        tunnel1 = details.get("tunnel_1", {})
        print(f"Inside CIDR: {tunnel1.get('inside_cidr', 'N/A')}")
        print(f"AWS BGP IP: {tunnel1.get('aws_side_bgp_ip', 'N/A')}")
        print(f"Peer BGP IP: {tunnel1.get('peer_side_bgp_ip', 'N/A')}")
        print(f"Outside Endpoint (AWS): {tunnel1.get('outside_endpoint', 'N/A')}")
        if aws_status:
            aws_t1 = aws_status.get("tunnel_1", {})
            print(f"Status: {GREEN}{aws_t1.get('status')}{NC}" if aws_t1.get('status') == 'UP' else f"Status: {RED}{aws_t1.get('status')}{NC}")
            if aws_t1.get('status_message'):
                print(f"Message: {aws_t1.get('status_message')}")
        print()

        # Tunnel 2
        print(f"{BOLD}Tunnel 2{NC}")
        print("-" * 70)
        tunnel2 = details.get("tunnel_2", {})
        print(f"Inside CIDR: {tunnel2.get('inside_cidr', 'N/A')}")
        print(f"AWS BGP IP: {tunnel2.get('aws_side_bgp_ip', 'N/A')}")
        print(f"Peer BGP IP: {tunnel2.get('peer_side_bgp_ip', 'N/A')}")
        print(f"Outside Endpoint (AWS): {tunnel2.get('outside_endpoint', 'N/A')}")
        if aws_status:
            aws_t2 = aws_status.get("tunnel_2", {})
            print(f"Status: {GREEN}{aws_t2.get('status')}{NC}" if aws_t2.get('status') == 'UP' else f"Status: {RED}{aws_t2.get('status')}{NC}")
            if aws_t2.get('status_message'):
                print(f"Message: {aws_t2.get('status_message')}")
        print()

        # Network Configuration
        print(f"{BOLD}Network Configuration{NC}")
        print("-" * 70)
        print("Peer CIDR Blocks (remote networks):")
        for cidr in details.get("peer_cidrs", []):
            print(f"  • {cidr}")
        print()
        print("Affinity CIDR Blocks (AWS networks):")
        for cidr in details.get("aws_cidrs", []):
            print(f"  • {cidr}")
        print()

        # Live AWS Status
        if aws_status:
            print(f"{BOLD}Live AWS Status{NC}")
            print("-" * 70)
            print(f"VPN Connection ID: {aws_status.get('vpn_id', 'N/A')}")
            print(f"Connection State: {aws_status.get('state', 'N/A')}")
            print(f"Customer Gateway ID: {aws_status.get('customer_gateway_id', 'N/A')}")
            print()

        # Readiness
        print(f"{BOLD}Readiness Assessment{NC}")
        print("-" * 70)
        if details['status'] == 'template':
            print(f"{YELLOW}⚠{NC} This is a template peer (not deployed)")
            print(f"  → Enable in vpn-peers.yaml to deploy")
        elif details['status'] == 'production':
            print(f"{GREEN}✓{NC} Production peer")
            if aws_status:
                t1_up = aws_status.get("tunnel_1", {}).get("status") == "UP"
                t2_up = aws_status.get("tunnel_2", {}).get("status") == "UP"
                if t1_up and t2_up:
                    print(f"{GREEN}✓{NC} Both tunnels UP - Full redundancy")
                elif t1_up or t2_up:
                    print(f"{YELLOW}⚠{NC} One tunnel UP - Degraded mode")
                else:
                    print(f"{RED}✗{NC} Both tunnels DOWN - Check peer configuration")
        else:
            print(f"{YELLOW}⚠{NC} Status: {details['status']}")
        print()

    def print_json(self, peer_name: str, include_live: bool = False):
        """Print peer details as JSON"""
        details = self.get_peer_details(peer_name)

        if not details:
            print(json.dumps({"error": f"Peer '{peer_name}' not found"}, indent=2))
            sys.exit(1)

        if include_live:
            aws_status = self.get_live_aws_status(peer_name)
            details["aws_status"] = aws_status

        print(json.dumps(details, indent=2))

    def list_all_peers(self, format_type: str = "text"):
        """List all configured peers"""
        peers = self.get_all_peers()

        if not peers:
            print("No peers found in registry")
            return

        if format_type == "json":
            print(json.dumps(peers, indent=2))
        else:
            print(f"\n{BOLD}Configured VPN Peers{NC}")
            print("-" * 70)
            for peer in peers:
                status_icon = "✓" if peer["status"] == "production" else "⏳" if peer["status"] == "template" else "?"
                status_color = GREEN if peer["status"] == "production" else YELLOW
                print(f"  {status_color}{status_icon}{NC} {peer['name']:<20} ({peer['type']:<12}) [{peer['status']}]")
            print()


def main():
    parser = argparse.ArgumentParser(
        description="Get comprehensive details about a VPN peer",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Get all details for a peer
  ./skill-peer-details Vimenca

  # Get details with live AWS status
  ./skill-peer-details Vimenca --live

  # Get details as JSON
  ./skill-peer-details Vimenca --format json

  # List all peers
  ./skill-peer-details --list

  # List all peers as JSON
  ./skill-peer-details --list --json
        """
    )

    parser.add_argument(
        "peer",
        nargs="?",
        help="Peer name (e.g., Vimenca, CIBAO)"
    )
    parser.add_argument(
        "--live",
        action="store_true",
        help="Include live AWS status (requires AWS credentials)"
    )
    parser.add_argument(
        "--format",
        choices=["text", "json"],
        default="text",
        help="Output format (default: text)"
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="List all configured peers"
    )
    parser.add_argument(
        "--registry",
        help="Path to vpn-peers-registry.yaml"
    )
    parser.add_argument(
        "--region",
        default="us-east-2",
        help="AWS region (default: us-east-2)"
    )
    parser.add_argument(
        "--profile",
        default="affinity",
        help="AWS profile (default: affinity)"
    )

    args = parser.parse_args()

    # Initialize
    details = PeerDetails(
        registry_path=args.registry,
        region=args.region,
        profile=args.profile
    )

    # Handle --list
    if args.list:
        details.list_all_peers(format_type=args.format)
        return

    # Require peer name if not listing
    if not args.peer:
        parser.print_help()
        sys.exit(1)

    # Get peer details
    if args.format == "json":
        details.print_json(args.peer, include_live=args.live)
    else:
        details.print_peer_report(args.peer, include_live=args.live)


if __name__ == "__main__":
    main()
